# ===== ENVIRONMENT =====

# App
APP_ENV=development
APP_PORT=8080
APP_SECRET=change-me-in-production

# Public base URL of this backend, as reached by the browser (used to build file/download URLs)
PUBLIC_BASE_URL=http://localhost:18080

# File uploads & signed download URLs
# MAX_UPLOAD_MB: hard cap for multipart upload bodies (1-100, default 10)
MAX_UPLOAD_MB=10
# UPLOAD_DIR: where uploaded files are stored (relative to the API working dir)
UPLOAD_DIR=uploads
# FILE_URL_SECRET: HMAC key for signed /uploads/ links. Leave empty to derive
# a stable key from JWT_SECRET (recommended for single-service setups).
FILE_URL_SECRET=
# FILE_URL_TTL: how long a signed download link stays valid
FILE_URL_TTL=15m

# Realtime dev-only: mirror chat across ALL rooms (multi-tab demo). Never
# active when APP_ENV=production. Default off.
REALTIME_DEV_BROADCAST_ALL=false

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ai_interview
DB_SSL_MODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-me-jwt-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# LiveKit
LIVEKIT_HOST=localhost
LIVEKIT_PORT=7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_URL=ws://localhost:7880

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=30s

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-001

# S3 Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ai-interview
S3_REGION=us-east-1

# WebSocket
WS_PORT=8081
WS_MAX_CONNECTIONS=1000
WS_HEARTBEAT_INTERVAL=30s
WS_GRACE_PERIOD=120s

# Frontend
VITE_API_URL=http://localhost:18080/api/v1
VITE_WS_URL=ws://localhost:18081/ws/interview-room
VITE_LIVEKIT_URL=ws://localhost:17880
